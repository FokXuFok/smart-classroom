# ============================================================
# 环境变量模板：复制本文件为 .env 并填入真实值
#   cp .env.example .env   （Windows: copy .env.example .env）
# .env 已被 .gitignore 排除，真实密钥绝不进入 Git 仓库
# ============================================================

# 数据库连接（MySQL）：用户名/密码/端口/库名按本机实际情况修改
DB_URL=mysql+pymysql://root:你的密码@localhost:3306/smart_classroom?charset=utf8mb4

# JWT 签名密钥：请换成任意长随机串（泄露则任何人可伪造登录态）
SECRET_KEY=please-change-me-to-a-long-random-string

# 阿里百炼 API Key（AI 批改/答疑/备课助手）
# 留空或不配置时 AI 功能自动降级，不影响签到/作业评测等核心功能
DASHSCOPE_API_KEY=
