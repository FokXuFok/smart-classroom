<view class="container">
  <!-- 进行中签到 -->
  <view class="card">
    <view class="card-title">
      <text>📍 进行中签到</text>
      <text class="count-badge" wx:if="{{activeSessions.length > 0}}">{{activeSessions.length}}</text>
    </view>
    <block wx:if="{{activeSessions.length > 0}}">
      <!-- 会话选择 -->
      <picker mode="selector" range="{{activeSessions}}" range-key="course_name" value="{{selectedIndex}}" bindchange="onSessionChange">
        <view class="session-select">
          <view class="session-left">
            <text class="session-name">{{selectedSession.course_name}}</text>
            <text class="session-meta">范围 {{selectedSession.range_meters}}米 · {{selectedSession.duration_minutes}}分钟</text>
          </view>
          <view class="countdown {{remainingText === '已结束' ? 'ended' : ''}}">
            <text class="countdown-num">{{remainingText}}</text>
          </view>
        </view>
      </picker>

      <!-- ========== 向导流程 ========== -->
      <!-- 未开始：引导按钮 -->
      <block wx:if="{{flowStep === 'idle'}}">
        <view class="flow-intro">
          <view class="flow-steps-overview">
            <view class="flow-step-chip">① 指纹验证</view>
            <view class="flow-step-chip">② 人脸（含二维码）</view>
            <view class="flow-step-chip">③ 定位（自动获取）</view>
          </view>
          <view class="flow-tip">点击开始后，请将教师屏幕上的签到二维码与本人脸部一起拍入画面</view>
          <button class="btn btn-primary btn-block start-btn" bindtap="onStartCheckin">
            开始签到
          </button>
          <view class="flow-demo-link" bindtap="onDemoCheckin">演示签到（跳过人脸/指纹）</view>
        </view>
      </block>

      <!-- 第 1 步：指纹 -->
      <block wx:elif="{{flowStep === 'fingerprint'}}">
        <view class="flow-card">
          <view class="flow-header">
            <view class="flow-progress">1 / 3</view>
            <view class="flow-title">指纹验证</view>
          </view>
          <view class="flow-desc">请将手指放在手机指纹识别区域</view>
          <view class="factor-chip done-chip">🔒 使用手机系统指纹</view>
          <button class="btn btn-primary btn-block" bindtap="onCaptureFingerprint">
            开始指纹验证
          </button>
          <view class="step-status" wx:if="{{stepStatus}}">{{stepStatus}}</view>
          <view class="loc-status" wx:if="{{geoState === 'ok'}}">📍 定位：{{geoText}}</view>
          <view class="loc-status warn" wx:elif="{{geoState === 'fallback'}}">📍 定位获取失败，将使用教师坐标（后端判定）</view>
        </view>
      </block>

      <!-- 第 2 步：人脸（单帧，须含教师屏幕二维码） -->
      <block wx:elif="{{flowStep === 'face'}}">
        <view class="flow-card">
          <view class="flow-header">
            <view class="flow-progress">2 / 2</view>
            <view class="flow-title">人脸识别（含二维码）</view>
          </view>
          <view class="flow-desc">请将教师屏幕上的签到二维码与本人脸部一起拍入画面（照片须照到人脸与二维码）</view>

          <view class="factor-row">
            <view class="factor-icon {{faceChecked ? 'ok' : ''}}">
              {{faceChecked ? '✅' : '1️⃣'}}
            </view>
            <view class="factor-main">
              <view class="factor-title">正脸 · 含二维码</view>
              <view class="factor-sub">{{faceChecked ? '已采集' : '拍一张清晰的自拍（含屏幕二维码）'}}</view>
            </view>
            <button class="btn btn-sm {{faceChecked ? 'btn-outline' : 'btn-primary'}}" bindtap="onCaptureFace">
              {{faceChecked ? '重拍' : '拍照'}}
            </button>
          </view>

          <view class="step-status" wx:if="{{stepStatus}}">{{stepStatus}}</view>
          <view class="loc-status" wx:if="{{geoState === 'ok'}}">📍 定位：{{geoText}}</view>
          <view class="loc-status warn" wx:elif="{{geoState === 'fallback'}}">📍 定位获取失败，将使用教师坐标（后端判定）</view>
        </view>
      </block>

      <!-- 完成：可提交 -->
      <block wx:elif="{{flowStep === 'ready'}}">
        <view class="flow-card">
          <view class="flow-header">
            <view class="flow-progress ok">✓</view>
            <view class="flow-title">因子已就绪</view>
          </view>
          <view class="ready-list">
            <view class="factor-row">
              <view class="factor-icon ok">✅</view>
              <view class="factor-main">
                <view class="factor-title">指纹验证</view>
                <view class="factor-sub">已通过</view>
              </view>
            </view>
            <view class="factor-row">
              <view class="factor-icon ok">✅</view>
              <view class="factor-main">
                <view class="factor-title">人脸识别（含二维码）</view>
                <view class="factor-sub">已采集</view>
              </view>
            </view>
            <view class="factor-row">
              <view class="factor-icon ok">✅</view>
              <view class="factor-main">
                <view class="factor-title">定位</view>
                <view class="factor-sub">
                  {{geoState === 'ok' ? '已获取 GPS 坐标' : geoState === 'fallback' ? '使用教师坐标（后端判定）' : '已就绪'}}
                </view>
              </view>
            </view>
          </view>
          <button
            class="btn btn-primary btn-block submit-btn"
            bindtap="onThreeFactorSubmit"
            loading="{{submitting}}"
          >
            提交签到（三因子）
          </button>
          <view class="flow-demo-link" bindtap="onDemoCheckin">演示签到（跳过人脸/指纹）</view>
        </view>
      </block>

      <view class="apply-link" bindtap="onOpenApply">
        无法签到？申请请假/补签 →
      </view>
    </block>
    <view class="empty" wx:else>
      <view class="empty-icon">⏰</view>
      暂无进行中的签到
    </view>
  </view>

  <!-- 人脸注册 -->
  <view class="card">
    <view class="card-title">📸 人脸注册</view>
    <view class="text-sub" style="margin-bottom: 20rpx;">
      首次使用人脸签到前需注册人脸模板。点击下方按钮拍照，系统将提取您的面部特征并保存。
    </view>
    <button class="btn btn-outline btn-block" bindtap="onFaceRegister" loading="{{registering}}">
      拍照注册人脸
    </button>
  </view>

  <!-- 签到历史 -->
  <view class="card">
    <view class="card-title">📋 签到历史</view>
    <block wx:if="{{history.length > 0}}">
      <view class="history-item" wx:for="{{history}}" wx:key="id">
        <view class="history-icon">{{item.status === 1 ? '✅' : item.status === 2 ? '⚠️' : item.status === 4 ? '📝' : '❌'}}</view>
        <view class="history-main">
          <view class="history-course">{{item.course_name}}</view>
          <view class="history-meta">{{item.attendance_date}} · {{item.check_in_time}}</view>
        </view>
        <view class="history-status">
          <text class="badge badge-ok" wx:if="{{item.status === 1}}">正常</text>
          <text class="badge badge-late" wx:elif="{{item.status === 2}}">迟到</text>
          <text class="badge badge-absent" wx:elif="{{item.status === 0}}">缺勤</text>
          <text class="badge badge-leave" wx:elif="{{item.status === 4}}">请假</text>
          <text class="badge badge-gray" wx:else>{{item.status_cn}}</text>
        </view>
      </view>
    </block>
    <view class="empty" wx:else>
      <view class="empty-icon">📭</view>
      暂无签到记录
    </view>
  </view>

  <!-- 请假弹窗 -->
  <view class="modal-mask" wx:if="{{showApply}}" bindtap="onCancelApply">
    <view class="modal-box" catchtap="">
      <view class="modal-title">请假 / 补签申请</view>
      <view class="form-label">请说明理由</view>
      <textarea
        class="form-textarea"
        placeholder="如：身体不适请假 / 网络问题未能及时签到等"
        value="{{applyReason}}"
        bindinput="onApplyReasonInput"
        maxlength="200"
      />
      <view class="modal-actions">
        <button class="btn btn-outline flex-1" bindtap="onCancelApply">取消</button>
        <button class="btn btn-primary flex-1" bindtap="onSubmitApply">提交申请</button>
      </view>
    </view>
  </view>
</view>