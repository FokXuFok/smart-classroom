.hw-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.hw-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.meta-tag {
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.meta-tag.lang-tag {
  background: #f0fdf4;
  color: #059669;
}

.hw-deadline-line {
  font-size: 24rpx;
  color: #ef4444;
  margin-top: 10rpx;
  font-weight: 500;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
  margin: 20rpx 0 14rpx;
}

.hw-desc {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.8;
  white-space: pre-wrap;
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
}

.case-item {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #c7d2fe;
}

.case-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.case-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.case-weight {
  font-size: 22rpx;
  color: #94a3b8;
}

.case-io {
  font-size: 24rpx;
  margin: 4rpx 0;
}

.io-label {
  color: #64748b;
}

.io-value {
  color: #1a1a2e;
  font-family: 'Consolas', monospace;
}

.case-hidden {
  font-size: 24rpx;
  color: #94a3b8;
  font-style: italic;
}

/* 代码编辑器 */
.code-editor {
  background: #1e293b;
  color: #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  font-family: 'Consolas', 'Monaco', monospace;
  width: 100%;
  box-sizing: border-box;
  min-height: 300rpx;
  line-height: 1.7;
}

/* 提交记录 */
.sub-item {
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.sub-item:last-child {
  margin-bottom: 0;
}

.sub-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.sub-time {
  font-size: 24rpx;
  color: #64748b;
  flex: 1;
}

.sub-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.score-num {
  color: #4f46e5;
}

.score-num.pending {
  color: #94a3b8;
  font-weight: 400;
}

.sub-error {
  background: #fef2f2;
  color: #dc2626;
  font-size: 24rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 12rpx;
  white-space: pre-wrap;
}

.ai-feedback {
  background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
  border-radius: 14rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  border-left: 6rpx solid #10b981;
}

.ai-feedback-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #059669;
  margin-bottom: 8rpx;
}

.ai-feedback-content {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.7;
  white-space: pre-wrap;
}

.ai-hint {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 12rpx;
}

.toggle-arrow {
  font-size: 24rpx;
  color: #4f46e5;
  font-weight: 400;
}
