.profile-page {
  min-height: 100vh;
}

.profile-header {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 50%, #7c3aed 100%);
  padding: 100rpx 40rpx 80rpx;
  position: relative;
  overflow: hidden;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.deco-1 {
  width: 280rpx;
  height: 280rpx;
  top: -80rpx;
  right: -60rpx;
}

.deco-2 {
  width: 180rpx;
  height: 180rpx;
  bottom: -40rpx;
  left: -30rpx;
}

.header-content {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 700;
  margin-right: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 42rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.user-id {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 6rpx;
}

.user-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.menu-card {
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
  padding: 12rpx 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 500;
}

.menu-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
  font-weight: 300;
}

.logout-btn {
  margin-top: 40rpx;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.app-version {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 40rpx;
}
