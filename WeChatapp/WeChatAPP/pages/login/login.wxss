.login-page {
  min-height: 100vh;
  background: #f0f2f5;
  position: relative;
}

.login-bg {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 50%, #7c3aed 100%);
  padding: 180rpx 0 140rpx;
  border-radius: 0 0 80rpx 80rpx;
  position: relative;
  overflow: hidden;
}

.deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.deco-1 {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -80rpx;
}

.deco-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: -60rpx;
  left: -40rpx;
}

.logo-wrap {
  text-align: center;
  position: relative;
  z-index: 1;
}

.logo-circle {
  width: 150rpx;
  height: 150rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.logo-emoji {
  font-size: 76rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 6rpx;
}

.app-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
  letter-spacing: 2rpx;
}

.login-card {
  margin: -80rpx 32rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 2;
}

.card-header {
  margin-bottom: 36rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a2e;
}

.card-sub {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 14rpx;
  font-weight: 500;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  transition: all 0.2s;
}

.input-wrap:focus-within {
  border-color: #818cf8;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(129, 140, 248, 0.15);
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.form-input {
  flex: 1;
  padding: 26rpx 0;
  font-size: 30rpx;
  color: #1a1a2e;
}

.picker-text {
  color: #1a1a2e;
}

.login-btn {
  margin-top: 12rpx;
  height: 92rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
  letter-spacing: 8rpx;
}

.register-link {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #4f46e5;
  font-weight: 500;
}

.footer-tip {
  text-align: center;
  margin-top: 48rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

/* ---------- 注册弹窗 ---------- */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(8rpx);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-box {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx;
  width: 100%;
  max-width: 640rpx;
  animation: modalIn 0.25s ease-out;
}

@keyframes modalIn {
  from { transform: scale(0.92); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 32rpx;
  text-align: center;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.form-tip {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 20rpx;
}
