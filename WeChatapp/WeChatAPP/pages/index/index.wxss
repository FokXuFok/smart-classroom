.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 32rpx;
}

.welcome {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a2e;
}

.welcome-sub {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.notif-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.notif-icon {
  font-size: 38rpx;
}

.notif-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  font-weight: 600;
}

/* 签到提醒横幅 */
.checkin-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #10b981, #059669);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
}

.banner-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.banner-icon {
  font-size: 40rpx;
}

.banner-content {
  flex: 1;
}

.banner-title {
  font-size: 30rpx;
  font-weight: 700;
}

.banner-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.banner-arrow {
  font-size: 44rpx;
  opacity: 0.8;
  font-weight: 300;
}

.course-count {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 400;
}

/* 课程列表 */
.course-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.course-item:last-child {
  border-bottom: none;
}

.course-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  min-width: 0;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 6rpx;
}

.course-meta {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}

.course-attend {
  font-size: 22rpx;
  color: #64748b;
}

.course-rate {
  width: 130rpx;
  text-align: center;
  flex-shrink: 0;
}

.rate-value {
  font-size: 30rpx;
  font-weight: 800;
  color: #4f46e5;
  margin-bottom: 10rpx;
}

.rate-bar {
  height: 8rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.rate-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  border-radius: 4rpx;
  transition: width 0.3s;
}
