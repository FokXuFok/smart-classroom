.tip-text {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  border: 2rpx solid #e2e8f0;
}

.picker-text {
  color: #1a1a2e;
}

.form-textarea {
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  border: 2rpx solid #e2e8f0;
}

.answer-box {
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.8;
  white-space: pre-wrap;
  background: linear-gradient(135deg, #eef2ff, #f5f3ff);
  border-radius: 16rpx;
  padding: 28rpx;
  border-left: 6rpx solid #4f46e5;
}

.hist-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.hist-item:last-child {
  border-bottom: none;
}

.hist-q, .hist-a {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.hist-q {
  margin-bottom: 12rpx;
}

.q-badge {
  background: #4f46e5;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  font-weight: 600;
}

.a-badge {
  background: #10b981;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  font-weight: 600;
}

.q-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.a-text {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}
