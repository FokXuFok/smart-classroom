.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.unread-text {
  font-size: 26rpx;
  color: #64748b;
}

.read-all-btn {
  font-size: 26rpx;
  color: #4f46e5;
  padding: 8rpx 20rpx;
  background: #eef2ff;
  border-radius: 24rpx;
  font-weight: 500;
}

.notif-item {
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.notif-item.unread {
  border-left: 6rpx solid #4f46e5;
}

.notif-item.read {
  opacity: 0.7;
}

.notif-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ef4444;
}

.notif-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #eef2ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.notif-emoji {
  font-size: 32rpx;
}

.notif-content {
  flex: 1;
  min-width: 0;
}

.notif-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.notif-item.read .notif-title {
  font-weight: 500;
  color: #64748b;
}

.notif-body {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.notif-time {
  font-size: 22rpx;
  color: #94a3b8;
}
